# ==============================================================================
# CINDERMARCH ENGINE HUB // TERMINAL 6
# Production & Multi-User Environment Configuration Template (.env.example)
# ==============================================================================

# Server Network Configuration
PORT=3001
NODE_ENV=production

# Frontend Client Origin (Allowed CORS Origin)
# Set to your production domain or local LAN IP (e.g. http://192.168.1.100:5173)
CLIENT_ORIGIN=http://localhost:5173

# Authentication & Session Security (Double-Submit CSRF + Signed Session Cookies)
# Generate a cryptographically secure random 64-character secret
SESSION_SECRET=cindermarch-dev-secret-replace-with-64-character-hex-in-prod

# Database Persistence
# For SQLite on persistent volume (default):
DATABASE_PATH=./data/cindermarch.db
# For managed PostgreSQL in production (e.g., Supabase / Neon / AWS RDS):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/cindermarch_t6

# Object Storage & Uploads
# Local disk path for uploaded evidence artifacts, test logs, and screenshots
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=104857600

# Unity Version Control (UVCS / Plastic SCM) Integration
# Leave empty for truthful MANUAL MODE (manual changeset ID linking)
UNITY_DEVOPS_TOKEN=
UNITY_ORGANIZATION_ID=
UNITY_PROJECT_ID=

# External Webhooks (Optional Fallback)
DISCORD_WEBHOOK_URL=

# ==============================================================================
# Cindermarch Operations Bot (Discord Service) Configuration
# ==============================================================================
# 1. Create a Discord Application at: https://discord.com/developers/applications
# 2. Add a Bot User, copy the Bot Token, and paste below:
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# 3. Application / Client ID (from General Information in Discord Developer Portal)
# Cindermarch Operations Bot Application ID: 1560406066867478681
DISCORD_CLIENT_ID=1560406066867478681

# 4. Target Guild / Server ID (Private Server Allowlist)
# Cindermarch Studio Private Guild ID: 1394770347030483034
DISCORD_GUILD_ID=1394770347030483034

# 5. Internal Server-to-Server API Security Key
# Shared between Engine Hub backend and Discord Bot service
INTERNAL_BOT_API_KEY=cindermarch-bot-internal-secret-replace-with-64-character-hex-in-prod

# 6. Service Network Endpoints
HUB_API_URL=http://localhost:3001/api/bot
HUB_WEB_URL=http://localhost:5173

# 7. Studio Timezone (Default for deadline calculations & reminder policies)
STUDIO_TIMEZONE=Africa/Cairo

