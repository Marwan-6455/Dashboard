# Cindermarch Engine Hub - Environment Configuration
# Terminal 6 Development Management

# Server Port
PORT=3001

# Client Origin (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Node Environment ('development' or 'production')
NODE_ENV=development

# Session Encryption Secret
SESSION_SECRET=cindermarch-terminal-6-secret-dev-key

# Database Path (defaults to data/cindermarch.db for SQLite)
# For hosted production PostgreSQL, use DATABASE_URL=postgresql://user:password@host:5432/cindermarch_t6
DATABASE_PATH=data/cindermarch.db

# Unity Version Control (Plastic SCM) - Future Automated Sync
UNITY_DEVOPS_TOKEN=
UNITY_ORGANIZATION_ID=cindermarch
UNITY_PROJECT_ID=Terminal6-Main

# Discord Bot Webhook
DISCORD_WEBHOOK_URL=
